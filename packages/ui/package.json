{
  "name": "@sibei/ui",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "The browser: a Svelte 5 shell over the /v1/ API, rendering through the same layout and engrave packages the PDF goes through.",
  "exports": {
    ".": "./src/lib/index.ts"
  },
  "types": "./src/lib/index.ts",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@sibei/engrave": "workspace:*",
    "@sibei/layout": "workspace:*",
    "@sibei/model": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "vite": "7.3.6"
  }
}
