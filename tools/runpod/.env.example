# tools/runpod/.env.example — NON-SECRET template. Copy to tools/runpod/.env (gitignored) and fill
# in a real key. NEVER commit tools/runpod/.env. See tools/runpod/README.md.
#
# `rp` sources tools/runpod/.env if it exists, then reads RUNPOD_API_KEY BY REFERENCE — it never
# echoes, prints, logs, bakes, or URL-encodes the key.

# A dedicated, LIMITED-SCOPE RunPod API key (create a separate key for this, revocable, minimal
# scope — not your account-wide key). Leave blank here; put the real value only in .env.
RUNPOD_API_KEY=

# The fixed name tag that makes `rp up` idempotent (reuse-if-present) and `rp down` targetable.
RP_POD_NAME=sibei-omr-eval

# The worker image to deploy — must be pushed to a registry the pod can pull. worker/Dockerfile
# builds this but pushes nowhere today; the one-time registry push is a prerequisite (see README).
# e.g. ghcr.io/<owner>/sibei-omr-worker:<tag>
RP_POD_IMAGE=

# The worker's HTTP port (ADR-0005). RP_PORT_TYPE=tcp gives a DIRECT publicIp:port (no proxy) and is
# REQUIRED for oemer: its /recognize runs minutes, and RunPod's http proxy (proxy.runpod.net) is
# Cloudflare-fronted with a ~100s cap that 524s a long request. Use http only for sub-100s services.
RP_POD_PORT=8000
RP_PORT_TYPE=tcp               # tcp (direct, no timeout) | http (proxy, <100s only)

# Cost cap (hard) and the price/bid we are willing to pay. `rp up` REFUSES if RP_HOURLY_USD exceeds
# RP_MAX_HOURLY_USD. oemer's blocker is RAM (~7 GB), not GPU — a high-RAM CPU pod (>=16 GB) is the
# target and is cheaper than GPU. GPU is only for later training (V15+).
RP_MAX_HOURLY_USD=0.60
RP_HOURLY_USD=0.40

# Pod-side dead-man's-switch timers (seconds). Baked into the launch command; they run INSIDE the
# pod, so they hold even if the laptop disconnects (RunPod has no native idle/max-lifetime/spend cap).
RP_MAX_LIFETIME_SECS=3600    # hard ceiling: terminate no matter what
RP_IDLE_TIMEOUT_SECS=900     # terminate after this long with no /recognize activity
RP_IDLE_CHECK_SECS=60        # watchdog poll interval

# Prefer spot/interruptible pods: cheaper, ~5s reclaim warning, and the eval job is re-runnable.
# RP_CLOUD_KIND=interruptible sets the REST v1 `interruptible` boolean; the cloud TYPE is separate.
RP_CLOUD_KIND=interruptible
RP_CLOUD_TYPE=SECURE           # SECURE | COMMUNITY (COMMUNITY is cheaper, less predictable)

# CPU-pod sizing (ADR-0025 floor). RunPod REST v1 needs computeType=CPU with a CPU flavor + vcpuCount;
# RAM comes from the flavor tier (…c compute / …g general / …m memory) times vcpuCount. oemer needs
# ~7 GB, so a memory-tier flavor with a small vcpuCount clears it cheaply. `rp up` verifies the pod's
# actual RAM and price from the create response and terminates+aborts (cents) if RAM < RP_MIN_RAM_GB
# or price > RP_MAX_HOURLY_USD. RP_VOLUME_GB=0 means NO persistent volume, so no wasted storage cost.
RP_CPU_FLAVORS=cpu5m,cpu3m     # tried in order for availability
RP_VCPU_COUNT=4
RP_MIN_RAM_GB=12               # abort if the pod comes up with less
RP_CONTAINER_DISK_GB=20        # ephemeral disk (holds the ~3 GB image + scratch); freed on terminate
RP_VOLUME_GB=0                 # 0 = no persistent volume

# The command that starts the worker inside the image (must match the worker image, ADR-0005).
# MUST be quoted — it contains spaces, and `rp` sources this file, so an unquoted value would run.
RP_WORKER_CMD="python -m sibei_omr.server"

# RunPod REST API v1 base (v2 is beta). This surface moves — verify at real-run time.
RP_API_BASE=https://rest.runpod.io/v1

# On-pod eval ssh (ADR-0032, KAN-1379). oemer's ~5.4-min recognition cannot survive a single HTTP
# request over the internet (the gate's four failures), so `rp eval-onpod` runs recognition ON the pod
# and moves only images (up) and OmrDocuments (down) over scp. The PUBLIC key below is embedded in the
# pod's launch command (not a secret); the PRIVATE key never leaves the laptop and is handed to ssh/scp
# by path only. If the public key file is absent, ssh is simply not enabled (port 22 not exposed) and
# the plain worker-URL flow is unaffected. openssh-server is installed at pod start, so the shipped
# worker image is untouched.
RP_SSH_KEY=~/.ssh/id_ed25519          # private key path (used locally, by reference, never printed)
# RP_SSH_PUBKEY=~/.ssh/id_ed25519.pub # defaults to $RP_SSH_KEY.pub; only its type+body are embedded
RP_EVAL_ENGINE=oemer                  # engine the on-pod batch runs (heuristic for a cheap smoke)
