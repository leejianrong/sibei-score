# Environment for compose.hosted.yaml. Copy to `.env` next to the compose file and fill in every value
# marked REQUIRED. `.env` holds secrets: it is gitignored, `chmod 600` it, and never paste it into a chat
# or a ticket. Generate each password with `openssl rand -hex 24` (hex only: these go into a URL and a SQL
# statement, so no quotes, no `@`, no `:`, no `/`).
#
# This file is a template and contains no secrets.

# --- the site ---------------------------------------------------------------------------------------
# REQUIRED. The domain Caddy serves and gets a certificate for. Its DNS A/AAAA record must already point at
# this VM, and ports 80 and 443 must be open to the internet.
SITE_ADDRESS=sibei.example.com
# Where Let's Encrypt sends expiry notices.
ACME_EMAIL=you@example.com
# REQUIRED. The address browsers use. Must be https and match SITE_ADDRESS. Its host is the one the
# Host/Origin guards admit (ADR-0029), so a mismatch makes every request a 403.
SBSCORE_PUBLIC_URL=https://sibei.example.com

# --- GitHub sign-in (all three are required: hosted mode is on only when all are set) ----------------
# Create an OAuth App at https://github.com/settings/developers with the callback URL
#   https://<your domain>/v1/auth/github/callback
# REQUIRED.
SBSCORE_GITHUB_CLIENT_ID=
# REQUIRED. Environment only: never a command-line flag.
SBSCORE_GITHUB_CLIENT_SECRET=

# --- the audio worker -------------------------------------------------------------------------------
# Comma-separated bearer tokens the audio transcription worker authenticates with (ADR-0034, audio worker
# protocol). Generate one per worker with `openssl rand -hex 32`. The API stores only their SHA-256. It has
# no effect until the audio endpoints are deployed; leave empty until then.
SBSCORE_AUDIO_WORKER_TOKENS=
# Audio-seconds each user may have transcribed per month (SEC H4). Leaving it unset in compose means 3600.
SBSCORE_AUDIO_FREE_SECONDS=3600

# --- the data stores --------------------------------------------------------------------------------
# REQUIRED. The Postgres superuser. Used for first-time setup and backups, never by the API.
POSTGRES_PASSWORD=
# REQUIRED. The `sibei_app` role the API connects as (not a superuser, so row-level security binds it).
SIBEI_APP_PASSWORD=
# REQUIRED. Redis AUTH password.
REDIS_PASSWORD=

# --- the OMR worker (photo import) ------------------------------------------------------------------
# Photo import is NOT part of the launch (ADR-0039): it is off, the worker is not started, and an image
# import answers `photo-import-unavailable`. To enable it, build a worker image with the bespoke weights
# baked in, set SBSCORE_PHOTO_IMPORT=on and run compose with `--profile photo-import`.
# SBSCORE_PHOTO_IMPORT=off
SIBEI_OMR_ENGINE=bespoke

# --- limits and quotas (optional; the defaults are conservative, see packages/api/src/limits/limits.ts) -
# SBSCORE_LIMIT_IP_PER_MIN=600
# SBSCORE_LIMIT_AUTH_IP_PER_MIN=30
# SBSCORE_LIMIT_USER_READ_PER_MIN=300
# SBSCORE_LIMIT_USER_WRITE_PER_MIN=120
# SBSCORE_LIMIT_USER_EXPORT_PER_MIN=20
# SBSCORE_LIMIT_USER_IMPORT_PER_HOUR=10
# SBSCORE_QUOTA_MAX_SCORES=200
# SBSCORE_QUOTA_IMPORT_PAGES_PER_DAY=30
# SBSCORE_QUOTA_IMPORT_MB_PER_DAY=100
# SBSCORE_QUOTA_MAX_STREAMS=8

# --- MCP consent (optional) --------------------------------------------------------------------------------
# Redirect hosts the MCP consent page treats as known clients, comma-separated (`*.example.com` matches
# subdomains). The default is claude.ai, *.claude.ai and loopback. Any other host gets a visible warning,
# because anyone can register an MCP client under any name. MCP tokens last 30 days.
# SBSCORE_MCP_KNOWN_HOSTS=claude.ai,*.claude.ai,localhost,127.0.0.1,[::1]

# --- images and ports (optional) ----------------------------------------------------------------------
# API_IMAGE=ghcr.io/<owner>/sibei-score-api:<tag>   # use a pushed image instead of building on the VM
# HTTP_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443

# --- backups (read by deploy/backup.sh; optional) ------------------------------------------------------
# An rclone remote and path the nightly dump is copied to, e.g. `offsite:sibei-backups`. Without it the
# dump stays on the VM only, which is not a backup.
# BACKUP_REMOTE=
# BACKUP_KEEP_DAYS=14
