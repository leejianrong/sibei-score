{
  "name": "sibei-score",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "A local-only jazz lead sheet notation app",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:fast": "vitest run --project fast",
    "test:infra": "vitest run --project infra",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/model && tsc --noEmit -p packages/layout && tsc --noEmit -p packages/engrave && tsc --noEmit -p packages/fixtures && tsc --noEmit -p packages/pdf && tsc --noEmit -p packages/api && tsc --noEmit -p packages/cli && tsc --noEmit -p tests && tsc --noEmit -p scripts && pnpm --filter @sibei/ui run typecheck",
    "check": "pnpm run typecheck && pnpm run test",
    "render": "tsx scripts/render-fixture.ts",
    "render:nasty": "tsx scripts/render-fixture.ts nasty-chart",
    "proof": "tsx scripts/proof.ts",
    "vendor:fonts": "tsx scripts/vendor-music-fonts.ts",
    "hooks:install": "git config core.hooksPath .githooks && echo \"git hooks -> .githooks\"",
    "sbscore": "tsx packages/cli/src/bin.ts",
    "serve": "tsx packages/cli/src/bin.ts serve",
    "ui": "pnpm --filter @sibei/ui run dev",
    "ui:build": "pnpm --filter @sibei/ui run build",
    "demo": "bash scripts/demo-v2.sh"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@sibei/api": "workspace:*",
    "@sibei/cli": "workspace:*",
    "@sibei/engrave": "workspace:*",
    "@sibei/fixtures": "workspace:*",
    "@sibei/layout": "workspace:*",
    "@sibei/model": "workspace:*",
    "@sibei/pdf": "workspace:*",
    "@sibei/ui": "workspace:*",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.13.1",
    "@types/opentype.js": "^1.3.10",
    "jsdom": "26.1.0",
    "opentype.js": "^2.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.13.0"
}
