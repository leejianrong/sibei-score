#!/bin/sh
#
# The fast gate. Mirrors the cheap CI jobs so a push rarely lands red.
#
# Install once per clone:   pnpm hooks:install
# Skip for a scoped push:   git push --no-verify   (CI is still the backstop)
#
# Keep this fast. Nothing that needs a database, a browser or a network should ever be
# added here — a slow pre-push hook gets bypassed, and then it protects nothing.
#
# From V2 the suite is two layers (vitest.config.ts) and this runs the FAST one only. The
# infra layer is CI's job; `pnpm test:infra` runs it on demand.

set -e

echo '[pre-push] typecheck'
pnpm run typecheck

echo '[pre-push] test (fast layer)'
pnpm run test:fast

echo '[pre-push] ok'
